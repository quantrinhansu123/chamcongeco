# Docker Compose only. Local Python uses backend/.env.example instead.
# Generate two different keys: python -c "import secrets; print(secrets.token_urlsafe(32))"
FACE_ADMIN_API_KEY=
FACE_KIOSK_API_KEY=
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Shared browser/server policy; tune only after testing actual cameras.
FACE_MIN_SHARPNESS=40
FACE_MIN_BRIGHTNESS=45
FACE_MAX_BRIGHTNESS=220
FACE_MIN_FACE_PIXELS=80
