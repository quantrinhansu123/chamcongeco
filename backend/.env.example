# Local development. Copy to backend/.env; never commit real keys/data.
APP_ENV=development
FACE_LOG_LEVEL=INFO
STORAGE_BACKEND=sqlite
FACE_ENGINE=insightface
FACE_TIMEZONE=Asia/Ho_Chi_Minh
FACE_CPU_THREADS=1
FACE_DETECTOR_SIZE=320
FACE_COSINE_THRESHOLD=0.50
FACE_RECOGNITION_MARGIN=0.08
FACE_LIVENESS_THRESHOLD=0.85
FACE_MIN_FACE_PIXELS=80
# face-quality-v2: float luminance/Laplacian on normalized 128x128 face ROI.
# Recalibrate any threshold previously tuned on native-resolution crops.
FACE_MIN_SHARPNESS=40
FACE_MIN_BRIGHTNESS=45
FACE_MAX_BRIGHTNESS=220
FACE_MIN_PUNCH_INTERVAL_SECONDS=30
FACE_GALLERY_REFRESH_SECONDS=30
FACE_GALLERY_MAX_AGE_SECONDS=120
FACE_ADMIN_API_KEY=
FACE_KIOSK_API_KEY=
FACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: absolute paths; defaults are backend/data/runtime and backend/models.
# FACE_DATA_DIR=
# FACE_MODEL_DIR=
# For Supabase, run schema.sql then 003_runtime.sql. Server credentials only.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=
